{
  "name": "Java 25 - IFBA",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bullseye", // Ou a imagem que você utiliza

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-test",
        "vscjava.vscode-java-dependency-viewer"
      ],
      "settings": {
        // Define que qualquer subpasta da raiz é considerada fonte válida sem exigir 'package'
        "java.project.sourcePaths": [
          "."
        ],
        // Garante suporte às funcionalidades de preview do Java (Unnamed Classes / void main)
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-25",
            "path": "/usr/lib/jvm/default-jvm", // Caminho do JDK no container
            "default": true
          }
        ]
      }
    }
  }
}
